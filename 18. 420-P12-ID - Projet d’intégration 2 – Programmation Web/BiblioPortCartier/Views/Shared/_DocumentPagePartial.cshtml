@using BiblioPortCartier.ViewModels;
@model BiblioViewModel;

<div class="card text-center mt-5">
    <div class="card-header">
        <h5>@Model.Document.Title</h5>
    </div>
    <div>
        <p>Créateur : @Model.Document.MakerName</p>
        <p>Année de publication : @Model.Document.PublishYear</p>
        <p>Categorie : @Model.Document.Category</p>
        <p>Type : @Model.Document.Rating</p>
        <p>Genre : @Model.Document.Genre</p>
        @if (!String.IsNullOrEmpty(Model.Document.ISBN))
        {
            <p>ISBN : @Model.Document.ISBN</p>
        }
        @if(!User.IsInRole("Member"))
        {
            @if (Model.Document.Loan != null)
            {
                <p class="fw-bold">Emprunté par : @Model.Document.Loan.Member.FullName</p>
            }
            @if (Model.Document.Reservation != null)
            {
                <p class="fw-bold">Réservé par : @Model.Document.Reservation.Member.FullName</p>
            }
        }
    </div>
</div>