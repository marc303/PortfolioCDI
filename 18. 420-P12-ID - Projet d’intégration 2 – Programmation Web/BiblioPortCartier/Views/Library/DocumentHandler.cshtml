@using BiblioPortCartier.ViewModels;
@model BiblioViewModel;

@{
    ViewData["Title"] = "Gestion d'un document";
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
}

<h2 class="text-center mt-5">Prêt et/ou réservation du document</h2>
@Html.Partial("~/Views/Shared/_DocumentPagePartial.cshtml")
<div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
<form method="post">
        @if (!Model.Document.IsBorrowed && !Model.Document.IsReserved)
        {
            <div class="row mt-3">
                <div class="col-2">
                    <label asp-for="MemberName" class="form-label">
                    </label>
                </div>
                <div class="col-10">
                    @Html.DropDownListFor(m => m.MemberName, new SelectList(Model.Membres, "Id", "FullName"), new { @class = "form-control" })
                </div>
            </div>
            <div class="row mt-3 mb-3">
                <div class="col-2">
                    <label asp-for="BorrowedDate" class="form-label">
                    </label>
                </div>
                <div class="col-4">
                    <input asp-for="BorrowedDate" class="form-control"></input>
                </div>
                <div class="col-2">
                    <label asp-for="ScheduledReturnDate" class="form-label">
                    </label>
                </div>
                <div class="col-4">
                    <input asp-for="ScheduledReturnDate" class="form-control"></input>
                </div>
            </div>
            <div class="row mt-3 mb-3">
                <div class="col-12">
                    <button class="btn btn-primary w-100" asp-controller="Library" asp-action="DocumentHandler" asp-route-id="0">Effectuer un emprunt</button>
                </div>
            </div>
            <hr />

        }
        else if (!Model.Document.IsReserved && Model.Document.IsBorrowed)
        {
            <div class="row mt-3">
                <div class="col-2">
                    <label asp-for="MemberName" class="form-label">
                    </label>
                </div>
                <div class="col-4">
                    @Html.DropDownListFor(m => m.MemberName, new SelectList(Model.Membres, "Id", "FullName"), new { @class = "form-control" })
                </div>
                <div class="col-2">
                    <label asp-for="ReservationDate" class="form-label">
                    </label>
                </div>
                <div class="col-4">
                    <input asp-for="ReservationDate" class="form-control"></input>
                </div>
            </div>
            <div class="row mt-3 mb-3">
                <div class="col-12">
                <button class="btn btn-primary w-100" asp-controller="Library" asp-action="DocumentHandler" asp-route-id="1">Effectuer la réservation</button>
                </div>
            </div>
            <hr />
            <div class="row mt-4 mb-3">
                <div class="col-12">
                <button class="btn btn-primary w-100" asp-controller="Library" asp-action="DocumentHandler" asp-route-id="2">Retourner l'emprunt</button>
                </div>
            </div>
            <hr />
        }
        else if (Model.Document.IsReserved && !Model.Document.IsBorrowed)
        {
            <div class="text-danger mt-3">Le membre @Model.Document.Reservation.Member.FullName a réservé ce document. Confirmer le prêt ou annuler la réservation pour ce membre.</div>
            <div class="row mt-3">
                <div class="col-2">
                    <label asp-for="BorrowedDate" class="form-label">
                    </label>
                </div>
                <div class="col-4">
                    <input asp-for="BorrowedDate" class="form-control"></input>
                </div>
                <div class="col-2">
                    <label asp-for="ScheduledReturnDate" class="form-label">
                    </label>
                </div>
                <div class="col-4">
                    <input asp-for="ScheduledReturnDate" class="form-control"></input>
                </div>
            </div>
            <div class="row mt-3 mb-3">
                <div class="col-6">
                <button class="btn btn-primary w-100" asp-controller="Library" asp-action="DocumentHandler" asp-route-id="4">Changer la réservation en prêt</button>
                </div>
                <div class="col-6">
                <button class="btn btn-primary w-100" asp-controller="Library" asp-action="DocumentHandler" asp-route-id="3">Annuler la réservation</button>
                </div>
            </div>
            <hr />
        }

        else
        {
            <div class="row mt-3">
                <div class="col-6">
                <button class="btn btn-primary w-100" asp-controller="Library" asp-action="DocumentHandler" asp-route-id="2">Retourner l'emprunt</button>
                </div>
                <div class="col-6">
                <button class="btn btn-primary w-100" asp-controller="Library" asp-action="DocumentHandler" asp-route-id="3">Annuler la réservation</button>
                </div>
            </div>
            <hr />
        }
    
    <button class="btn btn-primary mt-3 w-100" asp-controller="Library" asp-action="Documents">Retour à la bibliothèque</button>
</form>