@using BiblioPortCartier.ViewModels;
@model CreateMemberViewModel;

@{
    ViewData["Title"] = "Créer un membre";
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
}

<h2 class="text-center text-primary mt-5 mb-4">Création du membre</h2>
<form asp-action="CreateMember" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="accordion accordion-flush" id="accordionFlushExample">
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                    Informations personnelles :
                </button>
            </h2>
            <div id="flush-collapseOne" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">
                    @Html.Partial("~/Views/Shared/Members/_MemberInfoFormPartial.cshtml")
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseTwo" aria-expanded="false" aria-controls="flush-collapseTwo">
                    Adresse de résidence :
                </button>
            </h2>
            <div id="flush-collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">
                    @Html.Partial("~/Views/Shared/Members/_AddressFormPartial.cshtml")
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseThree" aria-expanded="false" aria-controls="flush-collapseThree">
                    Informations d'authentification :
                </button>
            </h2>
            <div id="flush-collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">
                    @Html.Partial("~/Views/Shared/_AuthFormPartial.cshtml")
                </div>
            </div>
        </div>
    </div>
    <button class="btn btn-success w-100 p-2" type="submit">Créer le membre</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}

