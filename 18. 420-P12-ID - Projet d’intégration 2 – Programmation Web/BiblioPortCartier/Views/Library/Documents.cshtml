@using BiblioPortCartier.ViewModels;
@model BiblioViewModel;

@{
    ViewData["Title"] = "Nos oeuvres";
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
}

<div class="container">
    <div class="row pt-4">
        <div class="col-4">
            <h1 class="text-primary">Liste des oeuvres</h1>
        </div>
        <div class="col-8">
            <form class="d-flex">
                <label asp-for="SelectedValue" class="form-label m-2"></label>
                <select asp-for="SelectedValue" class="form-select me-sm-2" aria-label="Default select example">
                    <option selected value="Title">Titre</option>
                    <option value="Maker">Créateur</option>
                    <option value="Year">Année de publication</option>
                    <option value="Category">Catégorie</option>
                    <option value="Type">Type</option>
                    <option value="Genre">Genre</option>
                </select>
                <input asp-for=SearchString class="form-control me-sm-2" type="search" placeholder="Recherche" id="searchField" />
                <button class="btn btn-secondary my-2 my-sm-0" type="submit" asp-controller="Library" asp-action="Documents">Rechercher</button>
            </form>
        </div>
    </div>
    <br />
    <br />
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    @Html.ActionLink("Titre", "Documents", new { sortOrder = ViewBag.TitleSortParm, selectedValue = Model.SelectedValue, searchString = Model.SearchString })
                </th>
                <th>
                    @Html.ActionLink("Créateur", "Documents", new { sortOrder = ViewBag.MakerSortParm, selectedValue = Model.SelectedValue, searchString = Model.SearchString })
                </th>
                <th>
                    @Html.ActionLink("Année de publication", "Documents", new { sortOrder = ViewBag.YearSortParm, selectedValue = Model.SelectedValue, searchString = Model.SearchString })
                </th>
                <th>
                    @Html.ActionLink("Catégorie", "Documents", new { sortOrder = ViewBag.CategorySortParm, selectedValue = Model.SelectedValue, searchString = Model.SearchString })
                </th>
                <th> 
                    @Html.ActionLink("Type", "Documents", new { sortOrder = ViewBag.TypeSortParm, selectedValue = Model.SelectedValue, searchString = Model.SearchString })
                </th>
                <th>
                    @Html.ActionLink("Genre", "Documents", new { sortOrder = ViewBag.GenreSortParm, selectedValue = Model.SelectedValue, searchString = Model.SearchString })
                </th>
                @if(User.IsInRole("Member"))
                {
                    <th></th>
                }
                else
                {
                    <th>Emprunté par</th>
                    <th>Réservé par</th>
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach(Document obj in Model.Documents)
            {
                <tr>
                    <td width="10%">@obj.Title</td>
                    <td width="10%">@obj.MakerName</td>
                    <td width="10%">@obj.PublishYear</td>
                    <td width="10%">@obj.Category</td>
                    <td width="10%">@obj.Rating</td>
                    <td width="10%">@obj.Genre</td>
                    @if(User.IsInRole("Member"))
                    {
                        <td width="15%">
                            <div class="w-75 btn-group" role="group">
                                @if (!obj.IsBorrowed && !obj.IsReserved)
                                {
                                    <a asp-controller="Library" asp-action="Borrow" asp-route-id="@obj.DocumentCode" class="btn btn-primary mx-2">Emprunter</a>
                                }
                                else if (!obj.IsReserved && !(obj.Loan.MemberId == Model.Member.Id))
                                {
                                    <a asp-controller="Library" asp-action="Reserve" asp-route-id="@obj.DocumentCode" class="btn btn-primary mx-2">Réserver</a>
                                }

                                
                                <a asp-controller="Library" asp-action="Details" asp-route-id="@obj.DocumentCode" class="btn btn-info mx-2">Détails</a>
                            </div>
                        </td>
                    }
                    else
                    {
                        if (obj.Loan == null)
                        {
                            <td width="10%"></td>
                        }
                        else
                        {
                            <td width="10%">@obj.Loan.Member.FullName</td>
                        }
                        if (obj.Reservation == null)
                        {
                            <td width="10%"></td>
                        }
                        else
                        {
                            <td width="10%">@obj.Reservation.Member.FullName</td>
                        }
                        <td width="10%">
                            <div class="w-75 btn-group" role="group">
                                <a asp-controller="Library" asp-action="DocumentHandler" asp-route-id="@obj.DocumentCode" class="btn btn-info mx-2">Gérer</a>
                            </div>
                        </td>
                    }

                </tr>   
            }
    </table>
</div>