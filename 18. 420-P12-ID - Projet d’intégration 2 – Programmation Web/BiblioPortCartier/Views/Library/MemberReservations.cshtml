@using BiblioPortCartier.ViewModels;
@model BiblioViewModel;

@{
    ViewData["Title"] = "Vos réservations";
    Layout = "~/Views/Shared/_LibraryLayout.cshtml";
}

<h2 class="text-center mt-5">Vos réservations - @Model.Member.FullName</h2>
@foreach (Reservation obj in Model.ReservationsMember)
{
    <div class="card text-center mt-5">
        <div class="card-header">
            <h5>@obj.Document.Title</h5>
        </div>
        <div>
            <p>Créateur : @obj.Document.MakerName</p>
            <p>Année de publication : @obj.Document.PublishYear</p>
            <p>Categorie : @obj.Document.Category</p>
            <p>Type : @obj.Document.Rating</p>
            <p>Genre : @obj.Document.Genre</p>
            @if(!String.IsNullOrEmpty(obj.Document.ISBN))
            {
                <p>ISBN : @obj.Document.ISBN</p>
            }
        </div>
        <div class="card-footer text-body-secondary">
            Date de réservation : @obj.ReservationDate.ToLongDateString()
        </div>
    </div>
}