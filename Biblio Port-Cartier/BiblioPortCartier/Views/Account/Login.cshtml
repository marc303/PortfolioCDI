@using BiblioPortCartier.ViewModels;
@model LogInViewModel;

@{
    ViewData["Title"] = "Se connecter";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-5 text-decoration-underline">Bibliothèque municipale de Port-Cartier</h2>
        <h3 class="text-center mb-4">Se connecter : </h3>
        <form asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control"/>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="float-end">
                <a asp-controller="Account" asp-action="VerifyEmail" class="text-decoration-none">
                    Mot de passe oublié?
                </a>
            </div>
            <div class="form-check mb-3">
                <label class="form-check-label">
                    <input asp-for="RememberMe" class="form-check-input"/>
                    @Html.DisplayNameFor(a => a.RememberMe)
                </label>
            </div>
            <input type="submit" value="Se connecter" class="btn btn-success w-100 p-2"/>
            <p class="text-center mt-2">
                Vous n'êtes pas membre? <a asp-controller="Account" asp-action="Register" class="text-decoration-none">S'inscrire</a>
            </p>
        </form>
    </div>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}