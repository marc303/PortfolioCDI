@using BiblioPortCartier.Helpers
@using Newtonsoft.Json
@{
    ViewData["Title"] = "Home Page";
    var currentUser = new User();
    var currentUserRole = TempData["currentUserRole"].ToString();
    if (currentUserRole == "Member")
    {
        currentUser = UsersHelper.Get<Member>(TempData, "currentUser");
    }
    else
    {
        currentUser = UsersHelper.Get<Employee>(TempData, "currentUser");
    }
}

<div class="text-center">
    <h1 class="display-4">Welcome @currentUser.FullName</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
