<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MegaStore</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/creer.css">
</head>

<body>
  <%- include('layouts/header'); -%>
    <div class="creer-parent">
      <div class="creer-menu">
        <%- include('layouts/navigation'); -%>
      </div>
      <div class="creer-form">
        <h1>Créer un Produit</h1>
        <br />
        <% if(erreurs !=null && erreurs.length> 0){ %>
          <ul class="list-group">
            <% for (var i=0; i < erreurs.length; i++) { %>
              <li class="list-group-item list-group-item-danger">
                <%= erreurs[i] %>
              </li>
              <% } %>
          </ul>
          <% } %>
            <form id="createproductForm" action="/produits/store" method="post" enctype="multipart/form-data">
              <div class="form-group was-validated" style="position: relative;">
                <label for="code">Code:</label>
                <input id="code" name="code" type="text" class="form-control" data-sb-validations="required" required />
                <div class="valid-tooltip">Champ valide!</div>
                <div class="invalid-tooltip" data-sb-feedback="code:required">Un code est requis.
                </div>
              </div>
              <div class="form-group mt-5 was-validated" style="position: relative;">
                <label for="nom">Nom:</label>
                <input id="nom" name="nom" type="text" class="form-control" data-sb-validations="required" required />
                <div class="valid-tooltip">Champ valide!</div>
                <div class="invalid-tooltip" data-sb-feedback="nom:required">Un nom est requis.
                </div>
              </div>
              <div class="form-group mt-5 was-validated" style="position: relative;">
                <label for="prix">Prix Unitaire:</label>
                <br />
                <input id="prix" name="prix" type="number" min="0" step=".01" class="form-control"
                  data-sb-validations="required" required />
                <div class="valid-tooltip">Champ valide!</div>
                <div class="invalid-tooltip" data-sb-feedback="prix:required">Un prix est requis.
                </div>
              </div>
              <div class="form-group mt-5" style="position: relative;">
                <label for="image">Image:</label>
                <input type="file" class="form-control" id="image" name="image">
              </div>
              <button id="submitButton" type="submit">Créer</button>
            </form>
      </div>
    </div>
</body>

</html>