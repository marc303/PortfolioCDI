<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MegaStore</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
  <link rel="stylesheet" href="css/styles.css">
  <link rel="stylesheet" href="css/stock.css">
</head>

<body>
  <%- include('layouts/header'); -%>
    <div class="stock-parent">
      <div class="stock-menu">
        <%- include('layouts/navigation'); -%>
      </div>
      <div class="stock-form">
        <h1>Envoyer des Stocks</h1>
        <% if(message !=null && message.length> 0){ %>
          <p class="list-group-item list-group-item-danger">
            <%= message %>
          </p>
          <% } %>
            <form id="sendstockForm" action="/produits/decreasestock" method="post" enctype="multipart/form-data">
              <div class="form-group was-validated" style="position: relative;">
                <label for="code">Code:</label>
                <input id="code" name="code" type="text" class="form-control" data-sb-validations="required" required />
                <div class="valid-tooltip">Champ valide!</div>
                <div class="invalid-tooltip" data-sb-feedback="code:required">Un code est requis.
                </div>
              </div>
              <div class="form-group mt-5 was-validated" style="position: relative;">
                <label for="quantite">Quantité à expédier:</label>
                <br />
                <input id="quantite" name="quantite" type="number" min="1" class="form-control"
                  data-sb-validations="required" required />
                <div class="valid-tooltip">Champ valide!</div>
                <div class="invalid-tooltip" data-sb-feedback="prix:required">Une quantite est requise.
                </div>
              </div>
              <br />
              <button id="submitButton" type="submit">Expédier</button>
            </form>
      </div>
    </div>
</body>

</html>